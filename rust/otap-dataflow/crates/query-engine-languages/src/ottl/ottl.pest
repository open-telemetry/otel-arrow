// OTTL Grammar is heavily influenced by the following source:
// https://github.com/open-telemetry/opentelemetry-collector-contrib/blob/main/pkg/ottl/LANGUAGE.md

// These two special rules, when defined, are implicitly allowed at:
// - at every sequence (split by ~)
// - between every repetition (+ or *)
// Atomics (marked with @) are excluded
// See https://pest.rs/book/grammars/syntax.html#implicit-whitespace
WHITESPACE = _{ " " | NEWLINE }
COMMENT = _{ ("/*" ~ (!"*/" ~ ANY)* ~ "*/") | ("//" ~ (!"\n" ~ ANY)*) }

// This boundry stops keywords matching as prefix to an identifier e.g. false_positive
// TODO: currently allows field_expression to match true.foo or true[0] (maybe disallow this in the future)
keyword_boundary = _{
    !("_" | ASCII_ALPHANUMERIC)
    ~ !("." ~ ident)
    ~ !("[" ~ index ~ "]")
}

// Literals
true_literal = @{ "true" ~ keyword_boundary }
false_literal = @{ "false" ~ keyword_boundary }
null_literal = @{ "nil" ~ keyword_boundary }
integer_literal = @{
    ("+" | "-")?
    ~ ("0" | ASCII_NONZERO_DIGIT ~ ASCII_DIGIT*)
    ~ !("." ~ ASCII_DIGIT)
}
float_literal = @{
    ("+" | "-")?
    ~ ((ASCII_DIGIT+ ~ "." ~ ASCII_DIGIT+) | ("." ~ ASCII_DIGIT+))
}
double_quote_string_char = _{
    !("\"" | "\\") ~ ANY
    | "\\" ~ ("\"" | "\\" | "n" | "r" | "t")
}
string_literal = @{
    "\"" ~ double_quote_string_char* ~ "\""
}

ident = @{ ("_" | ASCII_ALPHA) ~ ("_" | ASCII_ALPHANUMERIC)* }

// Expressions
boolean_expression = _{ true_literal | false_literal }

index = _{ string_literal | integer_literal }

field_expression = { ident ~ ("." ~ ident | "[" ~ index ~ "]")+ }

scalar_expression = {
    field_expression
    | boolean_expression
    | float_literal
    | integer_literal
    | string_literal
    | null_literal
    | identifier_expression
    | ("(" ~ scalar_expression ~ ")")
}

identifier_expression = {
    ident
}

argument_list = { scalar_expression? ~ ("," ~ scalar_expression)* }

// Equivalent of "editor" from collector-contrib OTTL grammar:
// https://github.com/open-telemetry/opentelemetry-collector-contrib/blob/655cd21d43a239447aa423839412f7ff06d2e9e8/pkg/ottl/grammar.go#L194-L199
editor_expression = { identifier_expression ~ "(" ~ argument_list ~ ")" }

// Equivalent of parsedStatement from collector-contrib OTTL grammar:
// https://github.com/open-telemetry/opentelemetry-collector-contrib/blob/655cd21d43a239447aa423839412f7ff06d2e9e8/pkg/ottl/grammar.go#L15
statement_expression = { editor_expression }


program = {
    SOI ~ statement_expression ~ EOI
}
