[
  {
    "urn": "urn:otel:receiver:syslog_cef",
    "probe": { "kind": "syslog-tcp" },
    "config": {
      "batch": { "max_size": 1 },
      "protocol": { "tcp": { "listening_addr": "{{ address }}" } }
    }
  },
  {
    "urn": "urn:otel:processor:attribute",
    "probe": { "kind": "log-attribute", "key": "guarantee.phase" },
    "config": { "actions": [{ "action": "upsert", "key": "guarantee.phase", "value": "{{ phase }}" }] }
  },
  {
    "urn": "urn:otel:processor:transform",
    "probe": { "kind": "log-attribute", "key": "guarantee.phase" },
    "config": { "opl_query": "logs | set attributes[\"guarantee.phase\"] = \"{{ phase }}\"" }
  },
  {
    "urn": "urn:otel:exporter:file",
    "probe": { "kind": "jsonl-file" },
    "config": { "path": "{{ output_file }}" }
  },
  {
    "urn": "urn:otel:extension:flat_file_api_key_auth",
    "probe": { "kind": "otlp-http-header", "capability": "api_key_provider", "header": "x-test-key" },
    "config": { "key_secret_file": "{{ key_file }}", "attributes": { "http.header_name": "x-test-key" } }
  }
]
