{
  "id": "windows-perf-counters-windows",
  "name": "Windows performance counters smoke",
  "runner": "windows-latest",
  "platform": "Windows",
  "timeout_minutes": 30,
  "required": true,
  "paths": [
    "rust/otap-dataflow/crates/contrib-nodes/src/receivers/windows_perf_counters_receiver/**",
    "rust/otap-dataflow/configs/windows-perf-counters-console.yaml",
    "rust/otap-dataflow/configs/windows-perf-counters-wildcard-console.yaml"
  ],
  "command": [
    "pwsh",
    "-NoProfile",
    "-File",
    "rust/otap-dataflow/crates/contrib-nodes/src/receivers/windows_perf_counters_receiver/ci/run.ps1"
  ]
}
