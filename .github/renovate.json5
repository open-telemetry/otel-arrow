{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  constraints: {
    go: '1.25.0',
  },
  osvVulnerabilityAlerts: true,
  vulnerabilityAlerts: {
    addLabels: [
      'area:security',
    ],
    schedule: [
      'at any time',
    ],
  },
  dependencyDashboard: {
    osvVulnerabilitySummary: 'unresolved',
  },
  extends: [
    'config:best-practices',
    'helpers:pinGitHubActionDigestsToSemver',
    ':semanticCommits',
    ':semanticCommitTypeAll(chore)',
  ],
  customManagers: [
    {
      customType: 'regex',
      description: 'Update Weaver CLI versions in GitHub workflows',
      managerFilePatterns: [
        '/^\\.github/workflows/.*\\.ya?ml$/',
      ],
      matchStrings: [
        'WEAVER_VERSION:\\s*(?<currentValue>v?\\d+\\.\\d+\\.\\d+)',
      ],
      depNameTemplate: 'open-telemetry/weaver',
      datasourceTemplate: 'github-releases',
    },
    {
      customType: 'regex',
      description: 'Update the pinned Renovate config validator',
      managerFilePatterns: [
        '/^\\.github/workflows/repo-lint\\.yaml$/',
      ],
      matchStrings: [
        '--package renovate@(?<currentValue>\\d+\\.\\d+\\.\\d+)',
      ],
      depNameTemplate: 'renovate',
      datasourceTemplate: 'npm',
    },
  ],
  packageRules: [
    {
      groupName: 'all patch versions',
      matchUpdateTypes: [
        'patch',
      ],
      schedule: [
        'before 8am on Friday',
      ],
    },
    {
      groupName: 'go patches and stable minors',
      matchManagers: [
        'gomod',
      ],
      matchUpdateTypes: [
        'patch',
      ],
      schedule: [
        'before 8am on Friday',
      ],
    },
    {
      groupName: 'go patches and stable minors',
      matchManagers: [
        'gomod',
      ],
      matchUpdateTypes: [
        'minor',
      ],
      matchCurrentVersion: '>=1.0.0',
      schedule: [
        'before 8am on Friday',
      ],
    },
    {
      groupName: 'rust patches and stable minors',
      matchManagers: [
        'cargo',
      ],
      matchUpdateTypes: [
        'patch',
      ],
      schedule: [
        'before 8am on Friday',
      ],
    },
    {
      groupName: 'rust patches and stable minors',
      matchManagers: [
        'cargo',
      ],
      matchUpdateTypes: [
        'minor',
      ],
      matchCurrentVersion: '>=1.0.0',
      schedule: [
        'before 8am on Friday',
      ],
    },
    {
      matchUpdateTypes: [
        'minor',
        'major',
      ],
      schedule: [
        'before 8am on Friday',
      ],
    },
    {
      groupName: 'weaver crates',
      matchManagers: [
        'cargo',
      ],
      matchDepNames: [
        'weaver_common',
        'weaver_forge',
        'weaver_resolved_schema',
        'weaver_resolver',
        'weaver_semconv',
      ],
      schedule: [
        'before 8am on Friday',
      ],
    },
    {
      groupName: 'opentelemetry crates',
      matchManagers: [
        'cargo',
      ],
      matchDepNames: [
        'opentelemetry',
        'opentelemetry_sdk',
        'opentelemetry-stdout',
        'opentelemetry-otlp',
        'opentelemetry-prometheus',
        'opentelemetry-proto',
      ],
      schedule: [
        'before 8am on Friday',
      ],
    },
    {
      groupName: 'kubernetes crates',
      separateMajorMinor: false,
      matchManagers: [
        'cargo',
      ],
      matchDepNames: [
        'kube',
        'k8s-openapi',
      ],
      schedule: [
        'before 8am on Friday',
      ],
    },
    {
      groupName: 'azure sdk crates',
      matchManagers: [
        'cargo',
      ],
      matchDepNames: [
        'azure_core',
        'azure_identity',
      ],
      schedule: [
        'before 8am on Friday',
      ],
    },
    {
      groupName: 'wasmtime crates',
      matchManagers: [
        'cargo',
      ],
      matchDepNames: [
        'wasmtime',
        'wasmtime-wasi',
      ],
      schedule: [
        'before 8am on Friday',
      ],
    },
    {
      groupName: 'github workflow dependencies',
      matchFileNames: [
        '.github/workflows/*.yml',
        '.github/workflows/*.yaml',
      ],
      schedule: [
        'before 8am on the first day of the month',
      ],
    },
    {
      matchManagers: [
        'github-actions',
      ],
      matchFileNames: [
        '.github/workflows/repo-lint.yaml',
      ],
      matchDepNames: [
        'node',
      ],
      allowedVersions: '24.x',
    },
    {
      matchManagers: [
        'github-actions',
      ],
      matchFileNames: [
        '.github/workflows/prepare-release.yml',
        '.github/workflows/push-release.yml',
      ],
      matchDepNames: [
        'rust',
      ],
      enabled: false,
    },
    {
      groupName: 'docker digest updates',
      matchUpdateTypes: [
        'digest',
      ],
      matchFileNames: [
        '**/Dockerfile',
      ],
      schedule: [
        'before 8am on the first day of the month',
      ],
    },
    {
      matchManagers: [
        'gomod',
      ],
      matchUpdateTypes: [
        'digest',
      ],
      schedule: [
        'before 8am on Friday',
      ],
    },
    {
      matchManagers: [
        'cargo',
      ],
      matchUpdateTypes: [
        'digest',
      ],
      schedule: [
        'before 8am on Friday',
      ],
    },
    {
      groupName: 'python dependencies',
      separateMajorMinor: false,
      separateMinorPatch: false,
      matchManagers: [
        'pip-compile',
      ],
      matchFileNames: [
        'tools/pipeline_perf_test/**/requirements.lock.txt',
        'tools/pipeline_perf_test/**/requirements.txt',
        'tools/comparison_dashboard/requirements.lock.txt',
        'tools/comparison_dashboard/requirements.txt',
      ],
      schedule: [
        'before 8am on Friday',
      ],
    },
    {
      matchManagers: [
        'pip_requirements',
      ],
      matchFileNames: [
        'tools/comparison_dashboard/requirements.txt',
        'tools/comparison_dashboard/requirements.lock.txt',
        'tools/pipeline_perf_test/**/requirements.txt',
        'tools/pipeline_perf_test/**/requirements.lock.txt',
      ],
      enabled: false,
    },
    {
      matchManagers: [
        'pip-compile',
      ],
      matchDepTypes: [
        'indirect',
      ],
      enabled: false,
    },
    {
      matchManagers: [
        'dockerfile',
        'github-actions',
      ],
      matchDepNames: [
        'python',
      ],
      groupName: 'python runtime',
      separateMajorMinor: false,
      separateMinorPatch: false,
      automerge: false,
      prBodyNotes: [
        'For interpreter upgrades, regenerate all three pip-compile lockfiles with the target Python, include any required companion dependency upgrades, and verify compatibility before merging.',
      ],
      schedule: [
        'before 8am on Friday',
      ],
    },
    {
      matchUpdateTypes: [
        'lockFileMaintenance',
      ],
      groupName: null,
      branchTopic: 'lock-file-maintenance',
      commitMessageAction: 'Refresh dependency lock files',
      schedule: [
        'before 8am on Friday',
      ],
    },
  ],
  'pip-compile': {
    managerFilePatterns: [
      '/(^|/)tools\\/(comparison_dashboard|pipeline_perf_test\\/.+)\\/requirements\\.lock\\.txt$/',
    ],
  },
  lockFileMaintenance: {
    enabled: true,
  },
  postUpdateOptions: [
    'gomodTidy',
  ],
  labels: [
    'dependencies',
  ],
}
