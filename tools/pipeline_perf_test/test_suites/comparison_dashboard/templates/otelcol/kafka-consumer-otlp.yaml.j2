receivers:
  # Benchmarked Go collector (Sarama) Kafka receiver. Aligned with the
  # canonical kafka_consumer_* suite variables to the extent Sarama exposes
  # each knob.
  kafka:
    brokers:
      - '{{kafka_hostname}}:9092'
    protocol_version: '3.0.0'
    group_id: '{{ kafka_consumer_group_id | default("kafka-benchmark-consumer") }}'
    initial_offset: {{ kafka_consumer_auto_offset_reset | default("earliest") }}
    autocommit:
      enable: true
      interval: {{ kafka_consumer_commit_interval_ms | default(1000) }}ms
    session_timeout: {{ kafka_consumer_session_timeout_ms | default(30000) }}ms
    heartbeat_interval: {{ kafka_consumer_heartbeat_interval_ms | default(3000) }}ms
    min_fetch_size: {{ kafka_consumer_fetch_min_bytes | default(1) }}
    default_fetch_size: {{ kafka_consumer_max_partition_fetch_bytes | default(1048576) }}
    max_fetch_size: {{ kafka_consumer_fetch_max_bytes | default(1048576) }}
    # NOTE: the Go collector (Sarama) kafkareceiver does not expose an
    # isolation_level setting; it is a librdkafka-only knob used by the DFE and
    # rotel receivers. Omitted here so the two rdkafka variants can still align.
    logs:
      topic: otel-logs
      encoding: otlp_proto
    metrics:
      topic: otel-metrics
      encoding: otlp_proto
    traces:
      topic: otel-spans
      encoding: otlp_proto

exporters:
  otlp:
    endpoint: '{{backend_hostname}}:1235'
    compression: {{ compression_method | default("none") }}
    tls:
      insecure: true
    sending_queue:
      enabled: {{ sending_queue_enabled | default(true) }}
      wait_for_result: {{ wait_for_result | default(true) }}
      block_on_overflow: {{ block_on_overflow | default(true) }}
      sizer: {{ sending_queue_sizer | default("requests") }}
      queue_size: {{ sending_queue_size | default(100) }}

service:
  telemetry:
    metrics:
      readers:
        - pull:
            exporter:
              prometheus:
                host: '0.0.0.0'
                port: 8088
  pipelines:
    {{signal}}:
      receivers: [kafka]
      exporters: [otlp]
